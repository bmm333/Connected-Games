    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "mqtt": "^5.16.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
