@startuml domain-model
' Modello di dominio (concettuale): entità, attributi principali, associazioni.
' Niente metodi, ID tecnici o dettagli di persistenza: quelli vanno nel
' diagramma delle classi di implementazione (T41).
' Senza Graphviz installato, togliere il commento alla riga seguente:
' !pragma layout smetana

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide methods
hide empty members

title Connected Games Platform - Modello di dominio

package "Utenti" {
  class Utente {
    nome : String
    email : String
  }
  class Ruolo {
    tipo : TipoRuolo
  }
  enum TipoRuolo {
    GIOCATORE
    GESTORE_LOCALE
    AMMINISTRATORE_GIOCO
    AMMINISTRATORE_PIATTAFORMA
  }
}

package "Organizzazioni e locali" {
  class Organizzazione {
    nome : String
  }
  class Locale {
    nome : String
    indirizzo : String
    citta : String
    tipo : TipoLocale
  }
  enum TipoLocale {
    PUBBLICO
    PRIVATO
  }
  class Tavolo {
    nome : String
    codice : String
    stato : StatoTavolo
  }
  enum StatoTavolo {
    LIBERO
    IN_PARTITA
    OFFLINE
    MANUTENZIONE
  }
  class Sensore {
    sorgente : SorgenteEvento
  }
  abstract class Dispositivo {
    identificativo : String
    statoConnessione : StatoConnessione
    ultimoContatto : DateTime
  }
  class Hub
  class TableNode
  enum StatoConnessione {
    ONLINE
    OFFLINE
  }
}

package "Giochi" {
  class TipoGioco {
    nome : String
    modalita : ModalitaGioco
    partecipantiPerLato : Integer
  }
  enum ModalitaGioco {
    INDIVIDUALE
    SQUADRE
  }
  class RegolePartita {
    puntiPerVincere : Integer
    durataMassima : Duration
  }
  class TipoSensore {
    nome : String
    descrizione : String
  }
  class TipoEvento {
    nome : String
    schemaDati : String
  }
  enum SorgenteEvento {
    CAMERA
    IR
    PULSANTE
    EMULATO
  }
}

package "Partite" {
  class Partita {
    inizio : DateTime
    fine : DateTime
    stato : StatoPartita
  }
  enum StatoPartita {
    IN_ATTESA
    IN_CORSO
    CONCLUSA
    ANNULLATA
  }
  class Partecipazione {
    lato : String
    punteggio : Integer
    vincitore : Boolean
  }
  abstract class Partecipante
  class Giocatore {
    nickname : String
    ospite : Boolean
  }
  class Squadra {
    nome : String
  }
  class EventoDiGioco {
    identificativo : UUID
    sequenza : Integer
    istante : DateTime
    sorgente : SorgenteEvento
    dati : String
  }
}

package "Tornei" {
  class Torneo {
    nome : String
    inizio : Date
    fine : Date
    formato : FormatoTorneo
    stato : StatoTorneo
  }
  enum FormatoTorneo {
    GIRONE
    ELIMINAZIONE_DIRETTA
  }
  enum StatoTorneo {
    ISCRIZIONI_APERTE
    IN_CORSO
    CONCLUSO
  }
  class Iscrizione {
    data : Date
  }
  class PosizioneClassifica {
    posizione : Integer
    punti : Integer
  }
}

' Utenti e ruoli
Utente "1" *-- "1..*" Ruolo
Ruolo "*" --> "0..1" Locale : ambito
Utente "0..1" -- "0..1" Giocatore : profilo di gioco

' Organizzazioni, locali, tavoli, dispositivi
Organizzazione "1" *-- "1..*" Locale : possiede
Locale "1" *-- "0..*" Tavolo : ospita
Locale "1" -- "0..*" Hub : è servito da
Dispositivo <|-- Hub
Dispositivo <|-- TableNode
Hub "1" -- "0..*" TableNode : coordina
TableNode "0..1" -- "1" Tavolo : osserva
Tavolo "1" *-- "0..*" Sensore : è dotato di

' Giochi
Tavolo "*" --> "1" TipoGioco : è un
TipoGioco "1" *-- "1" RegolePartita
TipoGioco "1" *-- "1..*" TipoSensore : prevede
TipoGioco "1" *-- "1..*" TipoEvento : registra
Sensore "*" --> "1" TipoSensore

' Partite
Tavolo "1" -- "0..*" Partita : si gioca su
Partita "1" *-- "2..*" Partecipazione
Partecipazione "*" --> "1" Partecipante
Partecipante <|-- Giocatore
Partecipante <|-- Squadra
Squadra "0..*" o-- "1..*" Giocatore : membri
Partita "1" *-- "0..*" EventoDiGioco
EventoDiGioco "*" --> "1" TipoEvento
EventoDiGioco "*" --> "0..1" Sensore : rilevato da

' Tornei
Torneo "*" --> "1" TipoGioco
Torneo "*" -- "1..*" Locale : coinvolge
Torneo "0..1" o-- "0..*" Partita : comprende
Torneo "1" *-- "0..*" Iscrizione
Iscrizione "*" --> "1" Partecipante
Torneo "1" *-- "0..*" PosizioneClassifica : classifica
PosizioneClassifica "*" --> "1" Partecipante

note bottom of Partecipazione
  Nelle partite a squadre si registra
  la Squadra, non i singoli giocatori.
end note

note bottom of EventoDiGioco
  Generato da sensore, camera o simulatore.
  Ordinato per sequenza dentro la partita;
  l'identificativo permette di scartare
  i duplicati dopo una sincronizzazione.
end note

note top of Torneo
  Un solo tipo di gioco, uno o più locali.
end note

note bottom of Giocatore
  Un ospite è un Giocatore
  senza Utente associato.
end note

@enduml
