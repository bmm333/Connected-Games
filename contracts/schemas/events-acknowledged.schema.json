{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventsAcknowledged",
  "type": "object",
  "required": ["venueId", "acknowledged", "processedAt"],
  "properties": {
    "venueId": { "type": "string" },
    "acknowledged": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "description": "Events saved (even if they were duplicates): the outbox marks them as sent"
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["eventId", "reason"],
        "properties": {
          "eventId": { "type": "string", "format": "uuid" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      },
      "description": "Invalid events: outbox marks them as rejected and they are not sent again"
    },
    "processedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}