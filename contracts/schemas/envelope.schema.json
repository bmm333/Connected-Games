{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Envelope",
    "description": "Common fields per each game",
    "type" : "object",
    "required" : ["eventId","tenantId","venueId","gameId","matchId","seq","type","occurredAt","source","payload"],
    "properties" : {"eventId":{"type": "string", "format" : "uuid", "description":"UUIDv7 unique: serves to discard duplicates"},
    "tenantId" : {"type":"string"},
    "venueId" : {"type":"string"},
    "gameId" : {"type":"string"},
    "matchId" : {"type":"string"},
    "seq" : {"type":"integer","minimum":1,"description":"Order of events inside match"},
    "type" : {"type":"string"},
    "occurredAt": {"type":"string","format":"date-time"},
    "source":{"enum":["CAMERA","IR","BUTTON","EMULATED"]},
    "payload":{"type":"object"}
    }
}
